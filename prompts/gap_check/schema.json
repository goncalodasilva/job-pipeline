{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["requirements", "framing_ideas"],
  "properties": {
    "requirements": {
      "type": "array", "maxItems": 200,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["requirement_id", "verdict", "fact_ids"],
        "properties": {
          "requirement_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
          "verdict": {"enum": ["met", "partial", "missing"]},
          "fact_ids": {"type": "array", "maxItems": 200, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^F[1-9][0-9]*@[1-9][0-9]*$"}}
        }
      }
    },
    "framing_ideas": {
      "type": "array", "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["text", "fact_ids"],
        "properties": {
          "text": {"type": "string", "minLength": 1, "maxLength": 500},
          "fact_ids": {"type": "array", "maxItems": 50, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^F[1-9][0-9]*@[1-9][0-9]*$"}}
        }
      }
    }
  }
}
