{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "text",
    "situation",
    "action",
    "result",
    "role_key",
    "skills",
    "missing",
    "added_details"
  ],
  "properties": {
    "type": {
      "enum": [
        "fact",
        "story"
      ]
    },
    "text": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f]+$"
    },
    "situation": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f]+$"
    },
    "action": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f]+$"
    },
    "result": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f]+$"
    },
    "role_key": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.@-]+$"
    },
    "skills": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f]+$"
      }
    },
    "missing": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "result",
          "number",
          "scale",
          "own_part",
          "context"
        ]
      }
    },
    "added_details": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f]+$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "fact"
          }
        }
      },
      "then": {
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f]+$"
          },
          "situation": {
            "type": "null"
          },
          "action": {
            "type": "null"
          },
          "result": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "text": {
            "type": "null"
          }
        },
        "anyOf": [
          {
            "properties": {
              "situation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000,
                "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f]+$"
              }
            }
          },
          {
            "properties": {
              "action": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000,
                "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f]+$"
              }
            }
          },
          {
            "properties": {
              "result": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000,
                "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f]+$"
              }
            }
          }
        ]
      }
    }
  ]
}
