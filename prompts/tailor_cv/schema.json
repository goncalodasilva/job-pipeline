{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["units"],
  "properties": {
    "units": {
      "type": "array", "minItems": 1, "maxItems": 80,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "section", "role", "text", "fact_ids", "added_details"],
        "properties": {
          "kind": {"enum": ["content", "structure"]},
          "section": {"enum": [
            "summary", "experience", "education", "skills", "projects", "certifications",
            "languages", "volunteering", "publications", "awards", "interests"
          ]},
          "role": {"type": ["string", "null"], "maxLength": 200},
          "text": {
            "type": "string", "minLength": 1, "maxLength": 400,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069]+(?![\\s\\S])"
          },
          "fact_ids": {
            "type": "array", "maxItems": 20, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^F[0-9]+@[0-9]+$"}
          },
          "added_details": {
            "type": "array", "maxItems": 10,
            "items": {
              "type": "string", "minLength": 1, "maxLength": 200,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069]+(?![\\s\\S])"
            }
          }
        }
      }
    }
  }
}
