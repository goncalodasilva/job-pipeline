{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "company",
    "industry",
    "department",
    "work_mode",
    "employment_type",
    "seniority",
    "experience_text",
    "salary_currency",
    "salary_period",
    "posted_date",
    "summary",
    "locations",
    "experience_min",
    "experience_max",
    "salary_min",
    "salary_max",
    "requirements"
  ],
  "properties": {
    "title": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "company": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "industry": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "department": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "work_mode": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "employment_type": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "seniority": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "experience_text": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "salary_currency": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "salary_period": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "posted_date": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "locations": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 300
      }
    },
    "experience_min": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "experience_max": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "salary_min": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1000000000
    },
    "salary_max": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1000000000
    },
    "requirements": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "text"
        ],
        "properties": {
          "kind": {
            "enum": [
              "must_have",
              "key",
              "nice"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          }
        }
      }
    }
  }
}
