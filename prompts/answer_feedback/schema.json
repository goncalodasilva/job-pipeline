{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checklist",
    "suggested_wording",
    "suggestions",
    "unsupported_claims"
  ],
  "properties": {
    "checklist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answers",
        "structure",
        "evidence"
      ],
      "properties": {
        "answers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verdict",
            "comment"
          ],
          "properties": {
            "verdict": {
              "enum": [
                "yes",
                "partly",
                "no"
              ]
            },
            "comment": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400,
              "pattern": "^(?=\\s*\\S)[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069]+(?![\\s\\S])"
            }
          }
        },
        "structure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verdict",
            "comment"
          ],
          "properties": {
            "verdict": {
              "enum": [
                "yes",
                "partly",
                "no"
              ]
            },
            "comment": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400,
              "pattern": "^(?=\\s*\\S)[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069]+(?![\\s\\S])"
            }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verdict",
            "comment"
          ],
          "properties": {
            "verdict": {
              "enum": [
                "yes",
                "partly",
                "no"
              ]
            },
            "comment": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400,
              "pattern": "^(?=\\s*\\S)[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069]+(?![\\s\\S])"
            }
          }
        }
      }
    },
    "suggestions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "fact_ids"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "pattern": "^(?=\\s*\\S)[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069]+(?![\\s\\S])"
          },
          "fact_ids": {
            "type": "array",
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "^F[1-9][0-9]*@[1-9][0-9]*(?![\\s\\S])"
            }
          }
        }
      }
    },
    "suggested_wording": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "added_details"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "^(?=\\s*\\S)[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069]+(?![\\s\\S])"
        },
        "added_details": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^(?=\\s*\\S)[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069]+(?![\\s\\S])"
          }
        }
      }
    },
    "unsupported_claims": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300,
        "pattern": "^(?=\\s*\\S)[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069]+(?![\\s\\S])"
      }
    }
  }
}
