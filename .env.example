# Copy to .env only for development or on systems without a keychain.
# Never commit .env. The app normally stores credentials in the OS keychain.

# Claude via API key (Claude Console)
ANTHROPIC_API_KEY=

# Claude via subscription: token from `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=

# Optional overrides
JOBPIPELINE_DATA_DIR=
JOBPIPELINE_PORT=8000
JOBPIPELINE_LOG_LEVEL=INFO

# Tests only
JOBPIPELINE_ALLOW_FAKE_PROVIDERS=0
JOBPIPELINE_LIVE_TESTS=0
