# Environment variables for the Job Search Pipeline (reference list only).
# The app does not load .env files; set these in your shell before running the app.
# Never store secrets in files. Use the OS keychain or `read -rs` to pass them to the app.
# For a live run, see docs/live-check-m1.md.

# Credentials (prefer the OS keychain; never commit real values):
# For API key (Claude Console): fallback when no keychain is available
ANTHROPIC_API_KEY=
# For subscription token (`claude setup-token`): fallback when no keychain is available
CLAUDE_CODE_OAUTH_TOKEN=

# Overrides for configuration resolution
JOBPIPELINE_DATA_DIR=
JOBPIPELINE_CONFIG_DIR=
JOBPIPELINE_PORT=
JOBPIPELINE_LOG_LEVEL=

# Allow fake providers in the running app (tests and demos only; value must be "1")
JOBPIPELINE_ALLOW_FAKE_PROVIDERS=

# Enable live tests that call real Claude services (value must be "1")
JOBPIPELINE_LIVE_TESTS=

# Live test credentials: set only in the shell with `read -rs` for a live run (docs/live-check-m1.md).
# Never store in .env; read only from JOBPIPELINE_LIVE_CLAUDE_OAUTH_TOKEN and JOBPIPELINE_LIVE_ANTHROPIC_API_KEY.

# Path to a Chromium executable for end-to-end tests (overrides Playwright's managed build)
JOBPIPELINE_E2E_CHROMIUM=
